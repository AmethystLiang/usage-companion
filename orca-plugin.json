{
  "manifestVersion": 2,
  "execution": "trusted-worker",
  "id": "limits-tracker",
  "name": "Usage Companion",
  "version": "0.2.1",
  "description": "Shows your Claude 5-hour and 7-day usage limits and when each one resets, refreshed every minute.",
  "repository": "https://github.com/renanluiz/limits-tracker",
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.246"
  },
  "pluginApi": 1,
  "main": "worker/main.mjs",
  "contributes": {
    "panels": [
      {
        "id": "limits",
        "title": "Usage Companion",
        "icon": "gauge",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ]
  }
}
